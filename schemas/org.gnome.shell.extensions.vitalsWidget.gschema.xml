<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.vitalswidget.Orientation">
    <value nick="horizontal" value="0"/>
    <value nick="vertical" value="1"/>
  </enum>

  <enum id="org.gnome.shell.extensions.vitalswidget.TempUnit">
    <value nick="percentage" value="0"/>
    <value nick="celcius" value="1"/>
    <value nick="fahrenheit" value="2"/>
  </enum>

  <enum id="org.gnome.shell.extensions.vitalswidget.HorizontalAnchor">
    <value nick="left" value="0"/>
    <value nick="center" value="1"/>
    <value nick="right" value="2"/>
  </enum>

  <enum id="org.gnome.shell.extensions.vitalswidget.VerticalAnchor">
    <value nick="top" value="0"/>
    <value nick="center" value="1"/>
    <value nick="bottom" value="2"/>
  </enum>

  <enum id="org.gnome.shell.extensions.vitalswidget.PositionUnit">
    <value nick="percent" value="0"/>
    <value nick="pixels" value="1"/>
  </enum>

  <schema id="org.gnome.shell.extensions.vitalswidget" path="/org/gnome/shell/extensions/vitalswidget/">
    <key name="position-x" type="d"><default>5</default></key>
    <key name="position-y" type="d"><default>88</default></key>
    <key name="position-x-anchor" enum="org.gnome.shell.extensions.vitalswidget.HorizontalAnchor">
      <default>'left'</default>
      <summary>Edge position-x is measured from</summary>
    </key>
    <key name="position-y-anchor" enum="org.gnome.shell.extensions.vitalswidget.VerticalAnchor">
      <default>'top'</default>
      <summary>Edge position-y is measured from</summary>
    </key>
    <key name="position-x-unit" enum="org.gnome.shell.extensions.vitalswidget.PositionUnit">
      <default>'percent'</default>
      <summary>Unit of position-x (percent of the monitor width or pixels)</summary>
    </key>
    <key name="position-y-unit" enum="org.gnome.shell.extensions.vitalswidget.PositionUnit">
      <default>'percent'</default>
      <summary>Unit of position-y (percent of the monitor height or pixels)</summary>
    </key>
    <key name="monitor-id" type="(sss)">
      <default>('', '', '')</default>
      <summary>Vendor, product and serial of the monitor showing the widget</summary>
      <description>All empty means the primary monitor.</description>
    </key>
    <key name="monitor-connector" type="s">
      <default>''</default>
      <summary>Connector of the chosen monitor, to tell identical monitors apart</summary>
    </key>
    <key name="monitor-name" type="s">
      <default>''</default>
      <summary>Name of the chosen monitor, shown while it is disconnected</summary>
    </key>
    <key name="allow-drag" type="b">
      <default>true</default>
      <summary>Move the widget by dragging it on the desktop</summary>
    </key>

    <key name="background-color" type="s"><default>'rgba(0, 0, 0, 0.8)'</default></key>
    <key name="border-color" type="s"><default>'rgba(255, 255, 255, 0.2)'</default></key>
    <key name="border-radius" type="i"><default>12</default></key>
    <key name="vital-spacing" type="i"><default>12</default></key>
    <key name="padding-horizontal" type="i"><default>16</default></key>
    <key name="padding-vertical" type="i"><default>12</default></key>
    <key name="orientation" enum="org.gnome.shell.extensions.vitalswidget.Orientation"><default>'horizontal'</default></key>
    <key name="vital-orientation" enum="org.gnome.shell.extensions.vitalswidget.Orientation">
    <default>'vertical'</default>
    <summary>Orientation of internal vital elements (Icon/Label)</summary>
    </key>

    <key name="show-icons" type="b"><default>true</default></key>
    <key name="show-labels" type="b">
      <default>true</default>
      <summary>Show text labels</summary>
    </key> 
    <key name="label-font-size" type="i">
      <default>11</default>
      <summary>Font size of the labels in pixels</summary>
    </key>
    <key name="icon-color" type="s"><default>'rgba(255, 255, 255, 0.9)'</default></key>

    <key name="show-cpu" type="b"><default>true</default></key>
    <key name="show-ram" type="b"><default>true</default></key>
    <key name="show-storage" type="b"><default>true</default></key>
    <key name="show-temp" type="b"><default>true</default></key>
    <key name="show-gpu" type="b"><default>true</default></key>

    <key name="cpu-color" type="s"><default>'#ca9ee6'</default></key>
    <key name="ram-color" type="s"><default>'#ca9ee6'</default></key>
    <key name="storage-color" type="s"><default>'#ca9ee6'</default></key>
    <key name="temp-color" type="s"><default>'#ca9ee6'</default></key>
    <key name="gpu-color" type="s"><default>'#ca9ee6'</default></key>

    <key name="cpu-update-interval" type="i"><default>2000</default></key>
    <key name="ram-update-interval" type="i"><default>2000</default></key>
    <key name="storage-update-interval" type="i"><default>60000</default></key>
    <key name="temp-update-interval" type="i"><default>5000</default></key>
    <key name="gpu-update-interval" type="i"><default>2000</default></key>
    
    <key name="show-rings" type="b"><default>true</default><summary>Show circular progress indicators</summary></key>
    <key name="temp-unit" enum="org.gnome.shell.extensions.vitalswidget.TempUnit"><default>'celcius'</default></key>

    <key name="enable-popups" type="b"> <default>true</default></key>

    <key name="ring-diameter" type="i"><default>64</default></key>
    <key name="ring-width" type="i"><default>4</default></key>
    <key name="inactive-ring-color" type="s">
    <default>'rgba(255, 255, 255, 0.1)'</default>
    <summary>Color of the progress ring track</summary>
    </key>
    <key name="extension-path" type="s"><default>''</default></key>
  </schema>
</schemalist>